# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/documind?retryWrites=true&w=majority

# Authentication Configuration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
JWT_EXPIRES_IN=7d

# --------------------------------------------------------------------------
# LLM Provider Configuration (DocuMind supports automatic cascade fallback)
# --------------------------------------------------------------------------

# Option A: Groq Cloud API (RECOMMENDED - Free, ultra-fast 500+ tok/s, 0 RAM usage on 512MB Render tier)
# Get free key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Option B: Google Gemini API (OpenAI-compatible endpoint)
# Get free key from: https://aistudio.google.com/app/apikey
# NOTE: baseURL must end with /openai/
LLM_API_KEY=your_gemini_api_key_here
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL_NAME=gemini-1.5-flash

# Option C: Hugging Face (Optional: for text embeddings)
# Get free token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_hugging_face_token_here

# Option D: Local Ollama (Optional: for offline local development with Ollama daemon running)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
